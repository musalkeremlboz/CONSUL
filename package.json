{
  "name": "consul",
  "productName": "CONSUL",
  "version": "1.0.0",
  "private": true,
  "description": "CONSUL — modern, sekmeli, proje hafızalı geliştirici terminali",
  "author": "Musa Kerem Boz",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "dist": "electron-vite build && electron-builder --dir",
    "package": "electron-vite build && electron-builder --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "smoke:pty": "node scripts/pty-smoke.mjs",
    "migrate:council-memory": "node scripts/migrate-council-memory.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/anton": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
